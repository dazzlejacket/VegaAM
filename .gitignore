# Build output
dist/
release/
release-*/
release-arm64/

# Dependencies
node_modules/

# Build caches
.cache/
.eslintcache
*.tsbuildinfo
.vite/
.electron-builder-cache/

# Local build credentials (Last.fm application key pair).
# Never commit these - see docs/SECURITY.md.
.env
.env.local
.env.*.local

# Verification artifacts (screenshots + telemetry; regenerated by the acceptance runs)
artifacts/
verification/
audit/

# Editor / OS
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local tooling shims (Windows build helpers, not part of the product)
.tooling/

# Packaging output for one-off local releases
*.blockmap
latest*.yml
