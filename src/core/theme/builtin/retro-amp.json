{
  "id": "retro-amp",
  "name": "Retro Amp",
  "version": "1.0.0",
  "author": "VegaAM",
  "description": "Graphite player window with a green LED readout, bevelled bitmap transport buttons and a compact list view.",
  "mode": "dark",
  "layout": "retro-amp",
  "supportsLight": true,
  "tokens": {
    "--bg": "#22262a",
    "--bg-elevated": "#2b3035",
    "--bg-sunken": "#15181b",
    "--surface": "#33383e",
    "--surface-2": "#3d444b",
    "--border": "#0a0b0c",
    "--text": "#d6dade",
    "--text-muted": "#8c939b",
    "--accent": "#00e05a",
    "--accent-2": "#1cc6c6",
    "--accent-contrast": "#04120a",
    "--success": "#5ddc5d",
    "--warning": "#e0c04a",
    "--danger": "#e04a4a",
    "--shadow": "#000000a6",
    "--radius": "2px",
    "--radius-lg": "3px",
    "--radius-sm": "1px",
    "--blur": "0px",
    "--font-family": "'Tahoma', 'MS Sans Serif', 'Segoe UI', sans-serif",
    "--font-size": "11px",
    "--font-size-display": "15px",
    "--sidebar-width": "184px",
    "--artwork-radius": "0px",
    "--artwork-size": "132px",
    "--player-padding": "10px",
    "--opacity-artwork": "0.08",
    "--opacity-grid": "0",
    "--display-style": "seven-segment",
    "--bezel": "#0d0f10",
    "--bezel-shadow": "#000000d9",
    "--knob": "#7d848c",
    "--meter-color": "#00e05a",
    "--segment-color": "#00e05a",
    "--segment-off": "#123a22",
    "--transport-style": "tactile",
    "--window-radius": "2px"
  }
}
