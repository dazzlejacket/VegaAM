{
  "id": "bluebird-classic",
  "name": "Bluebird Classic",
  "version": "1.0.0",
  "author": "VegaAM",
  "description": "Brushed silver panel with a blue LCD readout, glossy round controls and a source list in the sidebar.",
  "mode": "light",
  "layout": "bluebird-classic",
  "supportsLight": true,
  "tokens": {
    "--bg": "#d9dee5",
    "--bg-elevated": "#eef1f5",
    "--bg-sunken": "#c3cad4",
    "--surface": "#f4f6f9",
    "--surface-2": "#e4e8ee",
    "--border": "#a4adba",
    "--text": "#1a1e25",
    "--text-muted": "#5a6472",
    "--accent": "#2f6fd0",
    "--accent-2": "#7aa9e8",
    "--accent-contrast": "#ffffff",
    "--success": "#3f9c4f",
    "--warning": "#c1840f",
    "--danger": "#c0392b",
    "--shadow": "#39424f4d",
    "--radius": "6px",
    "--radius-lg": "10px",
    "--radius-sm": "3px",
    "--blur": "0px",
    "--font-family": "'Lucida Grande', 'Tahoma', 'Segoe UI', sans-serif",
    "--font-size": "12px",
    "--font-size-display": "22px",
    "--sidebar-width": "196px",
    "--artwork-radius": "3px",
    "--artwork-size": "176px",
    "--player-padding": "12px",
    "--opacity-artwork": "0.1",
    "--opacity-grid": "0",
    "--display-style": "lcd",
    "--bezel": "#b9c0ca",
    "--bezel-shadow": "#39424f66",
    "--knob": "#8e96a1",
    "--meter-color": "#3f9c4f",
    "--segment-color": "#2f6fd0",
    "--segment-off": "#c3cad3",
    "--transport-style": "classic",
    "--window-radius": "6px"
  }
}
