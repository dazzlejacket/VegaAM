{
  "id": "retro-satellite",
  "name": "Retro Satellite",
  "version": "1.0.0",
  "author": "VegaAM",
  "description": "Vintage satellite receiver with a segmented amber display, preset buttons and a machined bezel.",
  "mode": "dark",
  "layout": "retro-satellite",
  "supportsLight": true,
  "tokens": {
    "--bg": "#16130f",
    "--bg-elevated": "#221c15",
