{
  "id": "modern",
  "name": "Modern",
  "version": "1.0.0",
  "author": "VegaAM",
  "description": "Clean, contemporary music player with large artwork, soft blur and a calm dark palette.",
  "mode": "dark",
  "layout": "modern",
  "supportsLight": true,
  "tokens": {
    "--bg": "#0a0c11",
    "--bg-elevated": "#11151d",
    "--bg-sunken": "#06070b",
    "--surface": "#151a24",
    "--surface-2": "#1c2230",
    "--border": "#242c3a",
    "--text": "#eef2f9",
    "--text-muted": "#8e97ab",
    "--accent": "#4c8dff",
    "--accent-2": "#a06bff",
    "--accent-contrast": "#ffffff",
    "--success": "#37d399",
    "--warning": "#f5a524",
    "--danger": "#f2545b",
    "--shadow": "#00000073",
    "--radius": "14px",
    "--radius-lg": "22px",
    "--radius-sm": "8px",
    "--blur": "22px",
    "--font-family": "'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif",
    "--font-size": "14px",
    "--font-size-display": "32px",
    "--sidebar-width": "240px",
    "--artwork-radius": "20px",
    "--artwork-size": "288px",
    "--player-padding": "28px",
    "--opacity-artwork": "0.32",
    "--opacity-grid": "0.05",
    "--display-style": "none",
    "--bezel": "#171b24",
    "--bezel-shadow": "#00000066",
    "--knob": "#c8d0e0",
    "--meter-color": "#37d399",
    "--segment-color": "#ffb347",
    "--segment-off": "#3a2f1d",
    "--transport-style": "flat",
    "--window-radius": "14px"
  }
}
