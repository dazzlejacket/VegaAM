{
  "id": "classic-compact",
  "name": "Classic Compact",
  "version": "1.0.0",
  "author": "VegaAM",
  "description": "Compact classic player with dense song information, inset transport buttons and a small always-on display.",
  "mode": "dark",
  "layout": "classic-compact",
  "supportsLight": true,
  "tokens": {
    "--bg": "#1d1f22",
    "--bg-elevated": "#26282c",
    "--bg-sunken": "#131417",
    "--surface": "#2b2d32",
    "--surface-2": "#33363c",
    "--border": "#0d0e10",
    "--text": "#d7dbe0",
    "--text-muted": "#8b919b",
    "--accent": "#5ad4c4",
    "--accent-2": "#7fb2ff",
    "--accent-contrast": "#101215",
    "--success": "#63d471",
    "--warning": "#e2c14f",
    "--danger": "#e05a5a",
    "--shadow": "#000000a6",
    "--radius": "3px",
    "--radius-lg": "5px",
    "--radius-sm": "2px",
    "--blur": "4px",
    "--font-family": "'Tahoma', 'Segoe UI', system-ui, sans-serif",
    "--font-size": "13px",
    "--font-size-display": "20px",
    "--sidebar-width": "208px",
    "--artwork-radius": "3px",
    "--artwork-size": "184px",
    "--player-padding": "14px",
    "--opacity-artwork": "0.2",
    "--opacity-grid": "0.02",
    "--display-style": "lcd",
    "--bezel": "#101114",
    "--bezel-shadow": "#000000d9",
    "--knob": "#aeb4bd",
    "--meter-color": "#63d471",
    "--segment-color": "#5ad4c4",
    "--segment-off": "#1f2b2b",
    "--transport-style": "inset",
    "--window-radius": "4px"
  }
}
